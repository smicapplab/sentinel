{
  "name": "@sentinel/monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "pre-commit": "bash scripts/pre-commit-verify.sh",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "test": "turbo run test && pnpm run test:python",
    "test:python": "bash scripts/run-python-tests.sh",
    "db:check": "turbo run db:check",
    "db:push": "turbo run db:push"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.11.0"
}
