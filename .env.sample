# Stratos Integration Settings (For syncing plans to Stratos Board)
STRATOS_API_URL="http://localhost:5173/api/v1"
STRATOS_API_TOKEN="stratos_tok_TEST_LOCAL_DEV_DO_NOT_USE_IN_PRODUCTION"
STRATOS_STAGE_ID=""

# Local PostgreSQL Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/sentinel"

# Read-only connection to the Birdseye database for sync extraction (strict read-only role)
SYNC_DB_URL="postgresql://sync_readonly:<copy-SYNC_READONLY_PASSWORD-from-araneta-dev/.env>@localhost:5432/birdseye"
